# Fill in your credentials if you want ingest_copernicus.py
# to log in to Copernicus Marine automatically (useful in Docker / CI).
# This is NOT required for local usage: without this file, the script will simply
# ask for your username/password in the terminal on first run and store them in
# ~/.copernicusmarine.
#
# Create a free account once at: https://data.marine.copernicus.eu/register

COPERNICUSMARINE_SERVICE_USERNAME=logincredentials
COPERNICUSMARINE_SERVICE_PASSWORD=passwordcredentials
